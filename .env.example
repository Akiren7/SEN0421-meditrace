# MediTrace environment template.
#
# Copy this file to `.env` (already listed in .gitignore) and replace the values.
# NEVER commit `.env` or any real key or password to the repository (REQ-010, KVKK).
# The keys below are DUMMY keys (all-zero / all-one bytes) so that the local demo
# starts; anyone can read them, so they protect nothing.
#
# Generate your own keys (32 random bytes, base64):
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"

# PostgreSQL (docker compose service `db`)
POSTGRES_USER=meditrace
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=meditrace

# AES-256-GCM key of the Encrypted Data Layer (ARC-007, REQ-010) - DUMMY
DATA_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# HMAC-SHA256 key of the patient-name blind index (PLN-05, ADR-001) - DUMMY, must differ from DATA_KEY
INDEX_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=

# Local development without Docker uses SQLite by default:
# DATABASE_URL=sqlite:///./meditrace.db
